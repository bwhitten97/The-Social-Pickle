# Production Environment Variables for The Social Pickle
# Copy this file to .env.production and fill in your production values

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_production_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=the-social-pickle-6be90.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=the-social-pickle-6be90
VITE_FIREBASE_STORAGE_BUCKET=the-social-pickle-6be90.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Feature Flags
VITE_MULTI_CITY_ENABLED=false

# Production Settings
NODE_ENV=production