rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Users collection - Simple authenticated access
    match /users/{userId} {
      // Users can read/write their own profile
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow authenticated users to read other users (for discovery)
      allow read: if isAuthenticated();
    }
    
    // Games collection - Simple authenticated access
    match /games/{gameId} {
      allow read: if isAuthenticated();
      
      // Users can create/update/delete their own games
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.createdById;
      
      allow update, delete: if isAuthenticated() && 
        request.auth.uid == resource.data.createdById;
    }
    
    // Matches collection - Simple authenticated access for user's own matches
    match /matches/{matchId} {
      allow read, write: if isAuthenticated() && 
        request.auth.uid in resource.data.users;
      
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.users;
    }
    
    // Likes collection - Simple authenticated access
    match /likes/{likeId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == resource.data.likedBy ||
        request.auth.uid == resource.data.likedUser
      );
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.likedBy;
    }
    
    // Passes collection - Simple authenticated access
    match /passes/{passId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == resource.data.passedBy ||
        request.auth.uid == resource.data.passedUser
      );
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.passedBy;
    }
    
    // Messages collection - Simple authenticated access
    match /messages/{messageId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.fromUserId;
    }
    
    // Applications collection - Simple authenticated access
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.playerId ||
        request.auth.uid == resource.data.hostId
      );
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.playerId;
      
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.playerId ||
        request.auth.uid == resource.data.hostId
      );
      
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.playerId;
    }
    
    // Notifications collection - Simple authenticated access
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() && 
        request.auth.uid == resource.data.userId;
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.userId;
    }
    
    // Chat Rooms collection - Simple authenticated access
    match /chatRooms/{chatRoomId} {
      allow read, write, create: if isAuthenticated();
    }
  }
}