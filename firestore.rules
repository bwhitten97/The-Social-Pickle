rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to get user's city
    function getUserCity(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.city;
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if two users are from the same city
    function sameCity(userId1, userId2) {
      return getUserCity(userId1) == getUserCity(userId2);
    }
    
    // Users collection - strict city-based access control
    match /users/{userId} {
      // Users can read their own profile
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can read other users ONLY from their same city
      allow read: if isAuthenticated() && 
        resource.data.city == getUserCity(request.auth.uid) &&
        resource.data.city != null;
    }
    
    // Games collection - city-based filtering
    match /games/{gameId} {
      // Users can read games only from their city
      allow read: if isAuthenticated() && 
        resource.data.city == getUserCity(request.auth.uid);
      
      // Users can create/update their own games
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.createdById &&
        request.resource.data.city == getUserCity(request.auth.uid);
      
      allow update: if isAuthenticated() && 
        request.auth.uid == resource.data.createdById;
      
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.createdById;
    }
    
    // Matches collection - strict same-city enforcement
    match /matches/{matchId} {
      allow read, write: if isAuthenticated() && 
        request.auth.uid in resource.data.users &&
        // Verify both users are from same city
        sameCity(resource.data.users[0], resource.data.users[1]) &&
        resource.data.city == getUserCity(request.auth.uid);
      
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.users &&
        sameCity(request.resource.data.users[0], request.resource.data.users[1]);
    }
    
    // Likes collection - prevent cross-city likes
    match /likes/{likeId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == resource.data.likedBy ||
        request.auth.uid == resource.data.likedUser
      ) && resource.data.city == getUserCity(request.auth.uid);
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.likedBy &&
        sameCity(request.resource.data.likedBy, request.resource.data.likedUser);
    }
    
    // Passes collection - prevent cross-city passes
    match /passes/{passId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == resource.data.passedBy ||
        request.auth.uid == resource.data.passedUser
      ) && resource.data.city == getUserCity(request.auth.uid);
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.passedBy &&
        sameCity(request.resource.data.passedBy, request.resource.data.passedUser);
    }
    
    // Messages collection - strict same-city messaging
    match /messages/{messageId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      ) && sameCity(resource.data.fromUserId, resource.data.toUserId) &&
        resource.data.city == getUserCity(request.auth.uid);
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.fromUserId &&
        sameCity(request.resource.data.fromUserId, request.resource.data.toUserId);
    }
    
    // Applications collection - same-city game applications
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.playerId ||
        request.auth.uid == resource.data.hostId
      );
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.playerId;
      
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.playerId ||
        request.auth.uid == resource.data.hostId
      );
      
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.playerId;
    }
    
    // Notifications collection - user-specific access
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() && 
        request.auth.uid == resource.data.userId;
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.userId;
    }
  }
}