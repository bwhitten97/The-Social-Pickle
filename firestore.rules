rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to get user's city
    function getUserCity(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.city;
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if two users are from the same city
    function sameCity(userId1, userId2) {
      return getUserCity(userId1) == getUserCity(userId2);
    }
    
    // Users collection - TEMPORARY: Allow authenticated users to read all users
    match /users/{userId} {
      // Users can read/write their own profile
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      // TEMPORARY: Allow authenticated users to read other users
      allow read: if isAuthenticated();
    }
    
    // Games collection - city-based filtering
    match /games/{gameId} {
      // TEMPORARY FIX: Allow authenticated users to read games
      // TODO: Fix city-based filtering once getUserCity function works properly
      allow read: if isAuthenticated();
      
      // Users can create/update their own games
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.createdById;
      
      allow update: if isAuthenticated() && 
        request.auth.uid == resource.data.createdById;
      
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.createdById;
    }
    
    // Matches collection - TEMPORARY: Allow authenticated users to access matches
    match /matches/{matchId} {
      allow read, write: if isAuthenticated() && 
        request.auth.uid in resource.data.users;
      
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.users;
    }
    
    // Likes collection - TEMPORARY: Allow authenticated users to access likes
    match /likes/{likeId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == resource.data.likedBy ||
        request.auth.uid == resource.data.likedUser
      );
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.likedBy;
    }
    
    // Passes collection - TEMPORARY: Allow authenticated users to access passes
    match /passes/{passId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == resource.data.passedBy ||
        request.auth.uid == resource.data.passedUser
      );
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.passedBy;
    }
    
    // Messages collection - TEMPORARY: Allow authenticated users to access messages
    match /messages/{messageId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.fromUserId;
    }
    
    // Applications collection - same-city game applications
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.playerId ||
        request.auth.uid == resource.data.hostId
      );
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.playerId;
      
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.playerId ||
        request.auth.uid == resource.data.hostId
      );
      
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.playerId;
    }
    
    // Notifications collection - user-specific access
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() && 
        request.auth.uid == resource.data.userId;
      
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.userId;
    }
    
    // Chat Rooms collection - TEMPORARY: Allow authenticated users to access chat rooms
    match /chatRooms/{chatRoomId} {
      allow read, write: if isAuthenticated();
      allow create: if isAuthenticated();
    }
  }
}